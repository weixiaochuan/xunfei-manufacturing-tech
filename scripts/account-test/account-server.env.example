NODE_ENV=development
DEPLOYMENT_PROFILE=local
ALLOW_LOCAL_TEST_CASDOOR=true
ALLOW_INSECURE_PUBLIC_IP_TEST=false
ACCOUNT_SERVER_HOST=127.0.0.1
ACCOUNT_SERVER_PORT=18080
ACCOUNT_SERVER_PUBLIC_URL=http://127.0.0.1:18080
ACCOUNT_DB_HOST=127.0.0.1
ACCOUNT_DB_PORT=55432
ACCOUNT_DB_NAME=pomegranate_account_test
ACCOUNT_DB_USER=pomegranate_account_test
CASDOOR_BASE_URL=http://82.157.119.201:18000
CASDOOR_PUBLIC_URL=http://82.157.119.201:18000
CASDOOR_REDIRECT_URI=http://127.0.0.1:18080/auth/callback
CASDOOR_ORGANIZATION=pomegranate-test
CASDOOR_APPLICATION=app-pomegranate-test
FILE_STORAGE_BACKEND=filesystem
USER_FILE_MAX_BYTES=104857600

# Do not put real values in this file.
# Runtime scripts read these from files outside the repository:
#   postgres-password.tmp
#   casdoor-client-id.tmp
#   casdoor-client-secret.tmp
