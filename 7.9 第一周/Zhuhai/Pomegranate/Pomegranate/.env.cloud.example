# Public DNS configuration. Replace both example domains before deployment.
AUTH_DOMAIN=auth.example.com
API_DOMAIN=api.example.com
ACCOUNT_SERVER_PUBLIC_URL=https://api.example.com
CASDOOR_PUBLIC_URL=https://auth.example.com
CASDOOR_REDIRECT_URI=https://api.example.com/auth/callback

# PostgreSQL administrator credential: server-only, generate a unique random password.
POSTGRES_ADMIN_USER=pomegranate_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_RANDOM_POSTGRES_ADMIN_PASSWORD

# Casdoor database: server-only, use a separate role and random password.
CASDOOR_DB_HOST=postgres
CASDOOR_DB_PORT=5432
CASDOOR_DB_NAME=casdoor
CASDOOR_DB_USER=casdoor_app
CASDOOR_DB_PASSWORD=CHANGE_ME_RANDOM_CASDOOR_DATABASE_PASSWORD

# Account Server database: server-only, use a separate role and random password.
ACCOUNT_DB_HOST=postgres
ACCOUNT_DB_PORT=5432
ACCOUNT_DB_NAME=pomegranate_account
ACCOUNT_DB_USER=pomegranate_account_app
ACCOUNT_DB_PASSWORD=CHANGE_ME_RANDOM_ACCOUNT_DATABASE_PASSWORD

# Casdoor application identifiers. Client Secret is server-only and must be rotated.
CASDOOR_ORGANIZATION=pomegranate
CASDOOR_APPLICATION=app-pomegranate
CASDOOR_CLIENT_ID=REPLACE_WITH_CASDOOR_CLIENT_ID
CASDOOR_CLIENT_SECRET=CHANGE_ME_RANDOM_CASDOOR_CLIENT_SECRET

# Account Server production contract.
DEPLOYMENT_PROFILE=cloud
ACCOUNT_SERVER_HOST=0.0.0.0
ACCOUNT_SERVER_PORT=3010
NODE_ENV=production
FILE_STORAGE_BACKEND=filesystem
USER_FILES_ROOT=/srv/pomegranate/data/user-files
FILE_STORAGE_ALLOW_LEGACY_ROLLBACK=false
USER_FILE_MAX_BYTES=20971520
OIDC_DEBUG_CLAIM_TYPES=false

# Deployment paths and immutable image label.
POMEGRANATE_DATA_DIR=/srv/pomegranate/data
POMEGRANATE_UID=1000
POMEGRANATE_GID=1000
ACCOUNT_SERVER_IMAGE_TAG=cloud-test

# Caddy accepts multipart overhead above the 20 MiB application limit, but remains finite.
CADDY_MAX_REQUEST_BODY=24MB
