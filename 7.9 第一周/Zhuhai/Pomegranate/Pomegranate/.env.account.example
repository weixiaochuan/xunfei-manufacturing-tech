# Copy this file to .env.account and replace the password placeholders.
# These values are for local development only.

# PostgreSQL container bootstrap superuser and default maintenance database.
POSTGRES_USER=pomegranate_local
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Databases created by infra/account/postgres/init/001-create-databases.sql.
CASDOOR_DB_NAME=casdoor
ACCOUNT_SERVER_DB_NAME=pomegranate_account

# Casdoor-to-PostgreSQL connection inside the Compose network.
CASDOOR_DB_HOST=postgres
CASDOOR_DB_PORT=5432
CASDOOR_DB_USER=pomegranate_local
CASDOOR_DB_PASSWORD=replace-with-a-local-development-password
CASDOOR_PORT=8000
