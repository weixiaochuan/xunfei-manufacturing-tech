# Casdoor TEST is a separate local-only stack. Copy this file to
# .env.casdoor-test and replace every CHANGE_ME value before starting it.
CASDOOR_TEST_POSTGRES_ADMIN_USER=casdoor_test_admin
CASDOOR_TEST_POSTGRES_ADMIN_PASSWORD=CHANGE_ME_RANDOM_TEST_POSTGRES_ADMIN_PASSWORD

CASDOOR_TEST_DB_HOST=postgres-test
CASDOOR_TEST_DB_PORT=5432
CASDOOR_TEST_DB_NAME=casdoor_test
CASDOOR_TEST_DB_USER=casdoor_test_app
CASDOOR_TEST_DB_PASSWORD=CHANGE_ME_RANDOM_TEST_CASDOOR_DATABASE_PASSWORD

# The host binding is deliberately fixed to the loopback interface.
CASDOOR_TEST_HOST_PORT=18000
CASDOOR_TEST_PUBLIC_URL=http://127.0.0.1:18000

# Create these objects through the Casdoor administration UI after first start.
CASDOOR_TEST_ORGANIZATION=pomegranate-test
CASDOOR_TEST_APPLICATION=app-pomegranate-test

# Do not put a Client Secret in this Compose environment. Store each test
# application's secret only in the private environment of its consuming backend.
