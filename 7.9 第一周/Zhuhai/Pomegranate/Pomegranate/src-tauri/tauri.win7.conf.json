{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pomegranate",
  "mainBinaryName": "Pomegranate",
  "version": "1.8.0",
  "identifier": "edu.bit.inb",
  "build": {
    "beforeDevCommand": "pnpm dev:clean",
    "devUrl": "http://localhost:2010",
    "beforeBuildCommand": "npm run build:vite",
    "beforeBundleCommand": "node scripts/patch-win7-pe.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pomegranate",
        "width": 1330,
        "height": 830,
        "minWidth": 1000,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": true,
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://fonts.gstatic.com data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src 'self' http://localhost:* https://*; font-src 'self' data:; frame-src https://player.bilibili.com https://*.bilibili.com https://www.youtube.com https://www.youtube-nocookie.com https://v.qq.com https://*.qq.com https://player.youku.com https://*.youku.com https://player.vimeo.com https://*.vimeo.com https://player.twitch.tv https://*.twitch.tv https://www.dailymotion.com https://*.dailymotion.com",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://gitee.com/kadywen/Intelligent-NoteBook-release/raw/master/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3REE4REFFNjQ2NDlFQkUKUldTK25tUmtybzNhWjkvOEZBbXJZOHgwQlJJZExnY0VTempSc2gzSUhvS3Q3YjE5dU5LZDRqZmQK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": "v1Compatible",
    "externalBin": [
      "binaries/kb-mcp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/course-graph/process_graph.db",
      "resources/learning-assistant/knowledge-points/*.xlsx",
      "binaries/bcryptprimitives.dll",
      "binaries/api-ms-win-core-synch-l1-2-0.dll",
      "binaries/api-ms-win-core-winrt-l1-1-0.dll"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown 文件",
        "description": "由 Pomegranate 打开",
        "role": "Editor"
      }
    ],
    "copyright": "Copyright (c) 2026 AgileFR",
    "category": "Productivity",
    "shortDescription": "智能桌面随手笔记应用（Windows 7 兼容版 · 需预装 WebView2 109+）",
    "longDescription": "基于 Tauri 构建的本地笔记工具，支持 Markdown 编辑、全文搜索、双向链接、知识图谱、AI 问答等功能。\n\n本版本适用于已预装 WebView2 109+ 的 Windows 7 SP1 系统。",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer-hooks.nsi"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"],
        "section": "utility"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
