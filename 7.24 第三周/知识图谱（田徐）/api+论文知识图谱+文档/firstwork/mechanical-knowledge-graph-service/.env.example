# Mechanical manufacturing process knowledge graph
# Copy to .env and fill in local values. Never commit real credentials.

# Backend mode. This local course graph uses a self-hosted Neo4j Bolt database.
MEMORY_BACKEND=bolt

# Neo4j connection.
# Use a dedicated Neo4j database when available. If you use Neo4j Community,
# run it in an isolated container/volume and keep NEO4J_DATABASE=neo4j only for
# that dedicated instance.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=mechanical_process_graph

# Admin/debug routes are disabled by default. Keep false for Pomegranate use.
ENABLE_ADMIN_ROUTES=false

# Optional agent/vector/memory features. Core graph browsing does not require
# real model keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MEMORY_LLM=
MEMORY_EMBEDDING=
SESSION_STRATEGY=per_conversation

# Local ports.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS origins for optional separate web hosting. The backend also serves web/
# at http://127.0.0.1:${BACKEND_PORT}/.
# CORS_ORIGINS=http://localhost:3000

HF_HUB_DISABLE_TELEMETRY=1
